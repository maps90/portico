# --- Core ---
# Public base URL of this service (used to build OAuth redirect URIs and artifact links)
OMNI_BASE_URL=http://localhost:8080
OMNI_PORT=8080

# Postgres (Azure Database for PostgreSQL in prod)
OMNI_DATABASE_URL=postgresql://omni:omni@localhost:5432/omni

# 32-byte key (base64) for AES-256-GCM encryption of the upstream token vault.
# In prod, source from Azure Key Vault. Generate: openssl rand -base64 32
OMNI_ENCRYPTION_KEY=

# Secret for signing browser session cookies. Generate: openssl rand -base64 32
OMNI_SESSION_SECRET=

# --- Identity: Microsoft Entra (single-tenant = Okadoc) ---
OMNI_ENTRA_TENANT_ID=
OMNI_ENTRA_CLIENT_ID=
OMNI_ENTRA_CLIENT_SECRET=

# --- Artifact host: Azure Blob Storage ---
OMNI_ARTIFACT_BLOB_ACCOUNT=
OMNI_ARTIFACT_CONTAINER=omni-artifacts
# Optional explicit connection string; otherwise DefaultAzureCredential (managed identity) is used.
OMNI_ARTIFACT_BLOB_CONNECTION_STRING=

# --- Upstream OAuth client credentials (per service; add as registry grows) ---
# OMNI_UPSTREAM_JIRA_CLIENT_ID=
# OMNI_UPSTREAM_JIRA_CLIENT_SECRET=
# OMNI_UPSTREAM_GDRIVE_CLIENT_ID=
# OMNI_UPSTREAM_GDRIVE_CLIENT_SECRET=
