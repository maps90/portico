{
  "name": "portico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified MCP gateway + HTML artifact host (Google identity, per-user upstream OAuth vault, tool proxying).",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "portico": "dist/main.js"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "npm run build --workspace @portico/web",
    "dev": "tsx watch src/main.ts",
    "dev:web": "npm run dev --workspace @portico/web",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @portico/web",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "express": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
