# Template only — never put real credentials in this file. It is tracked by git.
# `make setup` copies it to .env (gitignored) and generates the secrets below.

# --- Core ---
# Public base URL of this service (used to build OAuth redirect URIs and artifact links)
PORTICO_BASE_URL=http://localhost:8080
PORTICO_PORT=8080

# Postgres. `make up` starts one matching this URL exactly.
# Leave unset to run with in-memory stores (data vanishes on restart).
PORTICO_DATABASE_URL=postgresql://portico:portico@localhost:5432/portico

# 32-byte key (base64) for AES-256-GCM encryption of the upstream token vault.
# In prod, source from Azure Key Vault. Generate: openssl rand -base64 32
PORTICO_ENCRYPTION_KEY=

# Secret for signing browser session cookies. Generate: openssl rand -base64 32
PORTICO_SESSION_SECRET=

# --- Identity: Google OIDC (Sign in with Google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#   -> Web application
#   -> Authorized redirect URI: http://localhost:8080/auth/google/callback
# This client only ever asks for openid/email/profile. It is NOT the same client as
# the Google Drive upstream below, which asks for file access.
PORTICO_GOOGLE_CLIENT_ID=
PORTICO_GOOGLE_CLIENT_SECRET=

# Comma-separated Google Workspace domains allowed to sign in. Checked against the
# `hd` claim, falling back to the email's domain.
# EMPTY = any Google account may sign in. Fine on localhost; set this before you put
# portico on a public URL.  Example: PORTICO_ALLOWED_DOMAINS=okadoc.com
PORTICO_ALLOWED_DOMAINS=

# --- Artifact host ---
# Local dev: leave the Azure vars empty and artifacts are written to disk under
# PORTICO_ARTIFACT_DIR. Production: set PORTICO_ARTIFACT_BLOB_ACCOUNT to switch to
# Azure Blob Storage (managed identity, or the connection string below).
PORTICO_ARTIFACT_DIR=.data/artifacts
PORTICO_ARTIFACT_BLOB_ACCOUNT=
PORTICO_ARTIFACT_CONTAINER=portico-artifacts
PORTICO_ARTIFACT_BLOB_CONNECTION_STRING=

# --- Upstream OAuth clients: the services you link, reached with one portico token ---

# Atlassian (Jira + Confluence) — one 3LO app covers both.
# developer.atlassian.com -> your app -> Authorization -> OAuth 2.0 (3LO)
#   -> Callback URL: http://localhost:8080/connect/atlassian/callback
# Also enable the Jira and Confluence APIs on the app's Permissions tab.
PORTICO_UPSTREAM_ATLASSIAN_CLIENT_ID=
PORTICO_UPSTREAM_ATLASSIAN_CLIENT_SECRET=

# Google Drive — a SECOND Google OAuth client, separate from the login one above.
#   -> Authorized redirect URI: http://localhost:8080/connect/google-drive/callback
PORTICO_UPSTREAM_GOOGLE_DRIVE_CLIENT_ID=
PORTICO_UPSTREAM_GOOGLE_DRIVE_CLIENT_SECRET=
# Google ships no public MCP server; set this only if you run a bridge yourself.
PORTICO_UPSTREAM_GOOGLE_DRIVE_MCP_URL=

# GitHub — github.com/settings/developers -> OAuth Apps
#   -> Authorization callback URL: http://localhost:8080/connect/github/callback
PORTICO_UPSTREAM_GITHUB_CLIENT_ID=
PORTICO_UPSTREAM_GITHUB_CLIENT_SECRET=
